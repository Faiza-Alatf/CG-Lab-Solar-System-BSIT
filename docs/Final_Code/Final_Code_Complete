void drawComet()
{
    glDisable(GL_LIGHTING);
    float ang=cometAngle*PI/180.0f;
    float tilt=30.0f*PI/180.0f;
    float R=70.0f;
    float x=R*cosf(ang);
    float y=R*sinf(ang)*sinf(tilt);
    float z=R*sinf(ang)*cosf(tilt)*0.28f;

    for (int layer=0; layer<12; layer++) {
        float la=layer*PI/6.0f;
        float sp=0.5f*(float)layer/(12.0f);
        float alpha=0.22f-layer*0.015f;
        if(alpha<0.01f) alpha=0.01f;
        float len=8.0f+layer*0.3f;
        glBegin(GL_LINES);
        glColor4f(0.5f,0.82f,1.0f,alpha);
        glVertex3f(x,y,z);
        glColor4f(0.25f,0.55f,1.0f,0.0f);
        glVertex3f(x+len*cosf(ang+PI)+sp*cosf(la),
                   y+len*0.25f,
                   z+len*sinf(ang+PI)+sp*sinf(la));
        glEnd();
    }
    glPushMatrix(); glTranslatef(x,y,z);
    glColor4f(0.5f,0.85f,1.0f,0.35f); glutSolidSphere(0.42f,12,12);
    glColor4f(0.9f,0.97f,1.0f,1.0f);  glutSolidSphere(0.20f,12,12);
    glPopMatrix();
    glEnable(GL_LIGHTING);
}

