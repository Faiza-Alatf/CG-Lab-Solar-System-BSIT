    glColor3f(0.55f,0.88f,1.0f);
    char status[280];
    sprintf(status,"  Days: %.0f  |  Speed: %.1fx  |  Cam: Yaw %.0f  Pitch %.0f  Zoom %.0f  |  %s%s",
        totalDays, speedMultiplier, camAngleY, camAngleX, camZoom,
        paused?"[ PAUSED ]":"[ RUNNING ]",
        droneCamera?" | DRONE CAM":"");
    printText(8,39,status);

    glColor3f(0.52f,0.52f,0.65f);
    printText(8,18,"[P] Pause  [+/-] Speed  [R] Reset  [O] Orbits  [T] Top View  [D] Drone Cam  [H] HUD  [F] Fullscreen  [1-8] Planet Info  [0] Close  [ESC] Quit | Mouse: Drag=Rotate, Scroll=Zoom");

    // ===== SPEED BAR =====
    int bx=W/2-100, by=43;
    glColor4f(0.05f,0.05f,0.15f,0.75f); fillRect(bx-2,by-2,204,18);
    glColor4f(0.15f,0.45f,0.85f,0.35f); frameRect(bx-2,by-2,204,18);
    float barW=(speedMultiplier/10.0f)*200.0f;
    float br=fminf(1.0f, speedMultiplier/5.0f);
    float bg=speedMultiplier>5.0f?fmaxf(0.0f,1.0f-(speedMultiplier-5.0f)/5.0f):1.0f;
    glColor4f(br*0.85f,bg*0.85f,0.18f,0.88f);
    fillRect(bx,by,barW,14);
    glColor3f(1,1,1);
    char spd[24]; sprintf(spd,"SPEED %.1fx",speedMultiplier);
    printText(bx+68,by+3,spd);

    // ===== LEFT PANEL: PLANET LEGEND =====
    // FIX 2: Planet list panel height = 8 planets x 18px + header ~30px = 174px
    //         Drone row drawn SEPARATELY below with its own background, no overlap.
    int lx=10;
    int planetPanelH = 178;  // height for header + 8 planets
    int dronePanelH  = 34;   // separate drone row height
    int gap          = 4;    // gap between the two panels

    // Top-left corner of planet panel (bottom of top bar = H-58)
    int panelTop = H - 58;   // y of top edge of planet panel
    int panelBot = panelTop - planetPanelH; // y of bottom edge

    // ---- Planet panel background ----
    glColor4f(0.0f,0.02f,0.10f,0.80f);
    fillRect(lx-5, panelBot, 160, planetPanelH);
    glColor4f(0.15f,0.45f,0.85f,0.35f);
    frameRect(lx-5, panelBot, 160, planetPanelH);

    // Header
    int headerY = panelTop - 18;
    glColor3f(0.95f,0.78f,0.25f);
    printText(lx+2, headerY, "PLANETS", GLUT_BITMAP_9_BY_15);
    glColor4f(0.15f,0.45f,0.85f,0.5f);
    fillRect(lx-5, headerY-6, 160, 1.5f);

    // Planet rows
    int rowY = headerY - 22;
    const char* pnames[]={"Mercury","Venus","Earth","Mars","Jupiter","Saturn","Uranus","Neptune"};
    float pcols[8][3]={
        {0.72f,0.70f,0.66f},{0.95f,0.78f,0.45f},{0.25f,0.52f,0.95f},
        {0.85f,0.35f,0.15f},{0.85f,0.68f,0.48f},{0.92f,0.85f,0.62f},
        {0.5f, 0.85f,0.92f},{0.18f,0.28f,0.95f}
    };
    for (int i=0; i<8; i++) {
        bool sel=(selectedPlanet==i+1);
        if (sel) {
            glColor4f(0.15f,0.45f,0.85f,0.25f);
            fillRect(lx-3, rowY-2, 155, 16);
        }
        glColor3f(pcols[i][0],pcols[i][1],pcols[i][2]);
        fillRect(lx, rowY, 9, 10);
        if (sel) glColor3f(0.3f,1.0f,0.55f);
        else     glColor3f(pcols[i][0]*0.85f,pcols[i][1]*0.85f,pcols[i][2]*0.85f);
        char tmp[24]; sprintf(tmp," %d. %s",i+1,pnames[i]);
        printText(lx+11, rowY, tmp);
        rowY -= 18;
    }

    // ---- Drone Camera row: drawn BELOW planet panel with gap ----
    int droneTop = panelBot - gap;         // top of drone panel
    int droneBot = droneTop - dronePanelH; // bottom of drone panel

    glColor4f(0.0f,0.02f,0.10f,0.80f);
    fillRect(lx-5, droneBot, 160, dronePanelH);
    glColor4f(0.15f,0.45f,0.85f,0.35f);
    frameRect(lx-5, droneBot, 160, dronePanelH);

    // Drone icon + label
    glColor3f(0.45f,0.88f,1.0f);
    printText(lx+2, droneBot+10, " [D] Drone Camera", GLUT_BITMAP_8_BY_13);
    if (droneCamera) {
        glColor3f(0.3f,1.0f,0.55f);
        printText(lx+118, droneBot+10, "[ON]");
    } else {
        glColor3f(0.45f,0.45f,0.55f);
        printText(lx+110, droneBot+10, "[OFF]");
    }

    // ===== RIGHT PANEL: PLANET INFO =====
    if (selectedPlanet>0 && selectedPlanet<=8) {
        if (infoPanelAlpha<1.0f) infoPanelAlpha+=0.06f;
        if (infoPanelSlide<1.0f) infoPanelSlide+=0.08f;
        if (infoPanelSlide>1.0f) infoPanelSlide=1.0f;
    } else {
        if (infoPanelAlpha>0.0f) infoPanelAlpha-=0.06f;
        if (infoPanelSlide>0.0f) infoPanelSlide-=0.08f;
        if (infoPanelSlide<0.0f) infoPanelSlide=0.0f;
    }

    if (infoPanelAlpha>0.01f && selectedPlanet>0) {
        PlanetInfo& p=planetData[selectedPlanet];
        float slideX=(1.0f-infoPanelSlide)*280.0f;
        int px=(int)(W-268+slideX), py=H-68; // shifted down for taller top bar
        float a=infoPanelAlpha;

        glColor4f(0.0f,0.02f,0.10f,0.88f*a); fillRect(px-8,py-195,270,200);
        glColor4f(p.r,p.g,p.b,0.85f*a); fillRect(px-8,py+2,270,4);
        glColor4f(p.r*0.5f,p.g*0.5f,p.b*0.5f,0.4f*a); frameRect(px-8,py-195,270,200,1.5f);

        glColor4f(p.r*1.1f,p.g*1.1f,p.b*1.1f,a);
        printText(px,py-10,p.name,GLUT_BITMAP_9_BY_15);

        glColor4f(p.r,p.g,p.b,0.35f*a); fillRect(px,py-20,250,1);

        glColor4f(0.65f,0.72f,0.88f,a);
        char line[80];
        sprintf(line,"Diameter  : %s",p.diameter);      printText(px,py-38,line);
        sprintf(line,"Dist. Sun : %s",p.distFromSun);   printText(px,py-54,line);
        sprintf(line,"Orbit     : %s",p.orbitalPeriod); printText(px,py-70,line);
        sprintf(line,"Moons     : %s",p.moons);          printText(px,py-86,line);

        glColor4f(0.35f,0.98f,0.58f,a);
        printText(px,py-106,"FUN FACT:");
        glColor4f(0.88f,0.90f,0.72f,a);
        const char* fact=p.funFact;
        int maxW=32, bi=0, fy=py-120;
        char buf[80]; buf[0]='\0';
        for (int fi=0; ; fi++) {
            buf[bi++]=fact[fi];
            if (fact[fi]=='\0'||(bi>=maxW&&fact[fi]==' ')) {
                buf[(fact[fi]==' ')?bi-1:bi]='\0';
                printText(px,fy,buf); fy-=15; bi=0;
                if (fact[fi]=='\0') break;
            }
        }
        glColor4f(0.4f,0.5f,0.6f,0.7f*a);
        printText(px,py-188,"[0] Close Panel");
    }

    // ===== VIEW MODE BADGE =====
    if (topDownView) {
        glColor4f(0.0f,0.5f,0.2f,0.75f); fillRect(W/2-65,H-78,130,18);
        glColor3f(0.25f,1.0f,0.55f);
        printText(W/2-60,H-74,"  TOP-DOWN VIEW");
    }
    if (droneCamera) {
        glColor4f(0.0f,0.2f,0.5f,0.75f); fillRect(W/2-65,H-100,130,18);
        glColor3f(0.4f,0.85f,1.0f);
        printText(W/2-60,H-96,"  DRONE  CAMERA");
    }

    // ===== MINI COMPASS (top right, moved down for taller top bar) =====
    int cx=W-60, cy=H-75;
    glColor4f(0.0f,0.02f,0.10f,0.72f);
    glBegin(GL_TRIANGLE_FAN);
    glVertex2i(cx,cy);
    for (int i=0;i<=32;i++){float aa=i*2*PI/32; glVertex2f(cx+22*cosf(aa),cy+22*sinf(aa));}
    glEnd();
    glColor4f(0.15f,0.45f,0.85f,0.5f);
    glBegin(GL_LINE_LOOP);
    for (int i=0;i<32;i++){float aa=i*2*PI/32; glVertex2f(cx+22*cosf(aa),cy+22*sinf(aa));}
    glEnd();
    float cya=-camAngleY*PI/180.0f;
    glColor3f(0.95f,0.25f,0.25f);
    glBegin(GL_LINES);
    glVertex2f(cx,cy);
    glVertex2f(cx+17*sinf(cya),cy+17*cosf(cya));
    glEnd();
    glColor3f(0.45f,0.45f,0.55f);
    glBegin(GL_LINES);
    glVertex2f(cx,cy);
    glVertex2f(cx-12*sinf(cya),cy-12*cosf(cya));
    glEnd();
    glColor3f(0.7f,0.7f,0.8f); printText(cx-2,cy+24,"N",GLUT_BITMAP_8_BY_13);

    glEnable(GL_DEPTH_TEST);
    glPopMatrix();
    glMatrixMode(GL_PROJECTION); glPopMatrix();
    glMatrixMode(GL_MODELVIEW);
    glEnable(GL_LIGHTING);
}

// ============================================================
//  DISPLAY
// ============================================================
void display()
{
    glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT);
    glLoadIdentity();

    if (droneCamera) {
        float lookX=droneX, lookY=droneY, lookZ=droneZ;
        float offAngle=(droneAngle+180.0f)*PI/180.0f;
        float tiltR=droneTilt*PI/180.0f;
        float eyeX=lookX + droneCamZoom*sinf(offAngle)*cosf(tiltR);
        float eyeY=lookY + droneCamZoom*sinf(tiltR);
        float eyeZ=lookZ + droneCamZoom*cosf(offAngle)*cosf(tiltR);
        gluLookAt(eyeX,eyeY,eyeZ, lookX,lookY,lookZ, 0,1,0);
    } else {
        float eax=topDownView?89.0f:camAngleX;
        float cy2=camZoom*sinf(camAngleY*PI/180.0f)*cosf(eax*PI/180.0f);
        float ey =camZoom*sinf(eax*PI/180.0f);
        float cz =camZoom*cosf(camAngleY*PI/180.0f)*cosf(eax*PI/180.0f);
        gluLookAt(cy2,ey,cz, 0,0,0, 0,1,0);
    }

    setupLighting();
    drawStars();
    drawShootingStar();
    drawKuiperBelt();
    drawAsteroidBelt();
    drawSun();
    drawMercury();
    drawVenus();
    drawEarthSystem();
    drawMarsSystem();
    drawJupiter();
    drawSaturn();
    drawUranus();
    drawNeptune();
    drawComet();
    drawDrone();
    drawHUD();

    glutSwapBuffers();
}

// ============================================================
//  TIMER / UPDATE
// ============================================================
void update(int)
{
    if (!paused) {
        float s=speedMultiplier;

        mercuryAngle +=4.15f*s; venusAngle  +=1.62f*s;
        earthAngle   +=1.00f*s; marsAngle   +=0.53f*s;
        jupiterAngle +=0.084f*s; saturnAngle +=0.034f*s;
        uranusAngle  +=0.012f*s; neptuneAngle+=0.006f*s;

        moonAngle    +=13.2f*s; phobosAngle +=22.0f*s;
        deimosAngle  +=10.5f*s; titaniaAngle+=5.5f*s;
        oberonAngle  +=3.8f*s;  tritonAngle +=8.0f*s;

        sunRotation    +=0.18f*s; earthRotation  +=5.2f*s;
        marsRotation   +=5.0f*s;  jupiterRotation+=12.0f*s;
        saturnRotation +=8.0f*s;  neptuneRotation+=4.0f*s;
        venusRotation  +=0.8f*s;  mercuryRotation+=0.6f*s;

        sunPulse      +=1.0f;
        asteroidAngle +=0.04f*s;
        cometAngle    +=0.14f*s;
        nebulaPhase   +=1.0f;
        totalDays     +=(1.0f/360.0f)*s;
        for (int i=1;i<=8;i++) planetGlowPhase[i]+=0.05f*s;

        droneAngle    +=0.35f*s;
        droneRotation +=2.0f*s;
        float da=droneAngle*PI/180.0f;
        float dt=droneTilt*PI/180.0f;
        droneX=droneRadius*cosf(da);
        droneY=droneRadius*sinf(da)*sinf(dt)*0.5f;
        droneZ=droneRadius*sinf(da)*cosf(dt);

        droneBlinkTimer+=1.0f;
        if (droneBlinkTimer>18.0f) { droneBlinkOn=!droneBlinkOn; droneBlinkTimer=0; }

        shootingStarTimer+=1.0f;
        if (shootingStar.active) {
            shootingStar.x+=shootingStar.dx;
            shootingStar.y+=shootingStar.dy;
            shootingStar.z+=shootingStar.dz;
            shootingStar.life-=1.0f;
            if (shootingStar.life<=0) shootingStar.active=false;
        } else if (shootingStarTimer>320.0f) {
            initShootingStar(); shootingStarTimer=0;
        }

        auto w=[](float& a){if(a>=360)a-=360;if(a<0)a+=360;};
        w(mercuryAngle); w(venusAngle);    w(earthAngle);    w(marsAngle);
        w(jupiterAngle); w(saturnAngle);   w(uranusAngle);   w(neptuneAngle);
        w(moonAngle);    w(phobosAngle);   w(deimosAngle);   w(titaniaAngle);
        w(oberonAngle);  w(tritonAngle);   w(sunRotation);   w(earthRotation);
        w(marsRotation); w(jupiterRotation);w(saturnRotation);w(neptuneRotation);
        w(venusRotation);w(mercuryRotation);w(asteroidAngle);w(cometAngle);
        w(droneAngle);   w(droneRotation);
    }
    glutPostRedisplay();
    glutTimerFunc(16,update,0);
}

// ============================================================
//  KEYBOARD
// ============================================================
void keyboard(unsigned char key, int, int)
{
    switch (key) {
        case 'p': case 'P': paused=!paused; break;
        case '+': case '=': speedMultiplier=fminf(speedMultiplier+0.5f,10.0f); break;
        case '-': case '_': speedMultiplier=fmaxf(speedMultiplier-0.5f,0.1f);  break;
        case 'o': case 'O': showOrbits=!showOrbits; break;
        case 't': case 'T': topDownView=!topDownView; droneCamera=false; break;
        case 'd': case 'D': droneCamera=!droneCamera; topDownView=false; break;
        case 'h': case 'H': showHUD=!showHUD; break;
        case 'f': case 'F':
            fullscreen=!fullscreen;
            if(fullscreen) glutFullScreen();
            else { glutReshapeWindow(1280,720); glutPositionWindow(60,30); }
            break;
        case '1': selectedPlanet=1; break; case '2': selectedPlanet=2; break;
        case '3': selectedPlanet=3; break; case '4': selectedPlanet=4; break;
        case '5': selectedPlanet=5; break; case '6': selectedPlanet=6; break;
        case '7': selectedPlanet=7; break; case '8': selectedPlanet=8; break;
        case '0': selectedPlanet=0; break;
        case 'r': case 'R':
            earthAngle=marsAngle=venusAngle=mercuryAngle=0;
            jupiterAngle=saturnAngle=uranusAngle=neptuneAngle=0;
            moonAngle=phobosAngle=deimosAngle=0;
            titaniaAngle=oberonAngle=tritonAngle=0;
            asteroidAngle=sunPulse=totalDays=cometAngle=droneAngle=0;
            speedMultiplier=1.0f; paused=false; selectedPlanet=0;
            topDownView=false; droneCamera=false; showOrbits=true; showHUD=true;
            break;
        case 27: exit(0);
    }
    glutPostRedisplay();
}

void specialKeys(int key, int, int)
{
    if (droneCamera) {
        switch(key){
            case GLUT_KEY_UP:    droneCamAngleX-=3; break;
            case GLUT_KEY_DOWN:  droneCamAngleX+=3; break;
            case GLUT_KEY_LEFT:  droneCamAngleY-=3; break;
            case GLUT_KEY_RIGHT: droneCamAngleY+=3; break;
        }
    } else {
        switch(key){
            case GLUT_KEY_UP:    camAngleX-=3; break;
            case GLUT_KEY_DOWN:  camAngleX+=3; break;
            case GLUT_KEY_LEFT:  camAngleY-=3; break;
            case GLUT_KEY_RIGHT: camAngleY+=3; break;
        }
        if(camAngleX> 88) camAngleX= 88;
        if(camAngleX<-88) camAngleX=-88;
    }
    glutPostRedisplay();
}

// ============================================================
//  MOUSE
// ============================================================
void mouse(int button, int state, int x, int y)
{
    if (button==GLUT_LEFT_BUTTON) { mouseDown=(state==GLUT_DOWN); lastMouseX=x; lastMouseY=y; }
    if (button==3) {
        if(droneCamera) droneCamZoom=fmaxf(droneCamZoom-2.0f,4.0f);
        else camZoom=fmaxf(camZoom-2.5f,10.0f);
        glutPostRedisplay();
    }
    if (button==4) {
        if(droneCamera) droneCamZoom=fminf(droneCamZoom+2.0f,80.0f);
        else camZoom=fminf(camZoom+2.5f,200.0f);
        glutPostRedisplay();
    }
}

void mouseMotion(int x, int y)
{
    if (mouseDown) {
        if (droneCamera) {
            droneCamAngleY+=(x-lastMouseX)*0.5f;
            droneCamAngleX+=(y-lastMouseY)*0.5f;
        } else {
            camAngleY+=(x-lastMouseX)*0.5f;
            camAngleX+=(y-lastMouseY)*0.5f;
            if(camAngleX> 88) camAngleX= 88;
            if(camAngleX<-88) camAngleX=-88;
        }
        lastMouseX=x; lastMouseY=y;
        glutPostRedisplay();
    }
}

// ============================================================
//  RESHAPE
// ============================================================
void reshape(int w, int h)
{
    if(h==0) h=1;
    glViewport(0,0,w,h);
    glMatrixMode(GL_PROJECTION); glLoadIdentity();
    gluPerspective(45.0,(double)w/h,0.3,900.0);
    glMatrixMode(GL_MODELVIEW);
}

