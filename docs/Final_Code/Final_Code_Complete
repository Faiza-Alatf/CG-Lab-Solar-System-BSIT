void printText(int x, int y, const char* s, void* font=GLUT_BITMAP_8_BY_13)
{
    glRasterPos2i(x,y);
    for (const char* c=s; *c; c++) glutBitmapCharacter(font,*c);
}

void printTextFloat(int x, int y, const char* fmt, float val, void* font=GLUT_BITMAP_8_BY_13)
{
    char buf[64]; sprintf(buf,fmt,val);
    printText(x,y,buf,font);
}

void fillRect(float x, float y, float w, float h)
{
    glBegin(GL_QUADS);
    glVertex2f(x,y); glVertex2f(x+w,y);
    glVertex2f(x+w,y+h); glVertex2f(x,y+h);
    glEnd();
}

void frameRect(float x, float y, float w, float h, float lw=1.0f)
{
    glLineWidth(lw);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x,y); glVertex2f(x+w,y);
    glVertex2f(x+w,y+h); glVertex2f(x,y+h);
    glEnd();
    glLineWidth(1.0f);
}

