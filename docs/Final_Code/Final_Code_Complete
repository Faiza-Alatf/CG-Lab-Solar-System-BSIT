void drawSelectionRing(float radius, float pulse)
{
    glDisable(GL_LIGHTING);
    float r = radius * 1.6f + 0.15f * sinf(pulse);
    glLineWidth(2.0f);
    glColor4f(0.2f, 1.0f, 0.5f, 0.7f + 0.3f*sinf(pulse*1.5f));
    glBegin(GL_LINE_LOOP);
    for (int i=0; i<64; i++) {
        float a = i * 2.0f * PI / 64.0f;
        glVertex3f(r*cosf(a), 0, r*sinf(a));
    }
    glEnd();
    glPushMatrix();
    glRotatef(pulse * 30.0f, 0, 1, 0);
    for (int i=0; i<4; i++) {
        float a = i * PI / 2.0f;
        glBegin(GL_LINES);
        glColor4f(0.2f, 1.0f, 0.5f, 0.9f);
        glVertex3f((r+0.1f)*cosf(a), 0, (r+0.1f)*sinf(a));
        glColor4f(0.2f, 1.0f, 0.5f, 0.0f);
        glVertex3f((r+0.5f)*cosf(a), 0, (r+0.5f)*sinf(a));
        glEnd();
    }
    glPopMatrix();
    glLineWidth(1.0f);
    glEnable(GL_LIGHTING);
}

void setupLighting()
{
    glEnable(GL_LIGHTING);
    glEnable(GL_LIGHT0);
    glEnable(GL_COLOR_MATERIAL);
    glColorMaterial(GL_FRONT, GL_AMBIENT_AND_DIFFUSE);

    GLfloat lPos[] = {0,0,0,1};
    GLfloat lAmb[] = {0.06f,0.05f,0.04f,1};
    GLfloat lDif[] = {1.0f,0.96f,0.84f,1};
    GLfloat lSpc[] = {1.0f,1.0f,0.9f,1};
    glLightfv(GL_LIGHT0, GL_POSITION, lPos);
    glLightfv(GL_LIGHT0, GL_AMBIENT,  lAmb);
    glLightfv(GL_LIGHT0, GL_DIFFUSE,  lDif);
    glLightfv(GL_LIGHT0, GL_SPECULAR, lSpc);
    glLightf(GL_LIGHT0, GL_CONSTANT_ATTENUATION,  1.0f);
    glLightf(GL_LIGHT0, GL_LINEAR_ATTENUATION,    0.003f);
    glLightf(GL_LIGHT0, GL_QUADRATIC_ATTENUATION, 0.0001f);

    GLfloat matSpec[]={0.4f,0.4f,0.4f,1};
    glMaterialfv(GL_FRONT, GL_SPECULAR, matSpec);
    glMaterialf (GL_FRONT, GL_SHININESS, 40.0f);
    glShadeModel(GL_SMOOTH);
}

void drawStars()
{
    glDisable(GL_LIGHTING);
    glDepthMask(GL_FALSE);
    float nb=0.03f+0.015f*sinf(nebulaPhase*0.008f);
    glColor4f(0.12f,0.04f,nb*4.0f,0.035f);
    glPushMatrix(); glTranslatef(-90,25,-160); glutSolidSphere(60,8,8); glPopMatrix();
    glColor4f(nb*2.0f,0.03f,0.15f,0.025f);
    glPushMatrix(); glTranslatef(130,-35,-190); glutSolidSphere(75,8,8); glPopMatrix();
    glColor4f(0.05f,nb*3.0f,0.08f,0.02f);
    glPushMatrix(); glTranslatef(50,60,-170); glutSolidSphere(50,8,8); glPopMatrix();
    glDepthMask(GL_TRUE);

    glPointSize(2.0f);
    glBegin(GL_POINTS);
    srand(42);
    for (int i=0; i<1800; i++) {
        float x=((rand()%600)-300)*1.0f;
        float y=((rand()%600)-300)*1.0f;
        float z=((rand()%600)-300)*1.0f;
        if (fabsf(x)<90&&fabsf(y)<90&&fabsf(z)<90) x+=150.0f;
        float twinkle=0.65f+0.35f*sinf(nebulaPhase*0.04f+i*0.41f);
        int type=rand()%8;
        if      (type==0) glColor4f(1.0f,0.82f,0.65f,twinkle);
        else if (type==1) glColor4f(0.68f,0.78f,1.0f,twinkle);
        else if (type==2) glColor4f(1.0f,0.92f,0.5f,twinkle*0.85f);
        else if (type==3) glColor4f(1.0f,0.45f,0.35f,twinkle*0.7f);
        else              glColor4f(1.0f,1.0f,1.0f,twinkle);
        glVertex3f(x,y,z);
    }
    glEnd();
    glEnable(GL_LIGHTING);
}

void initShootingStar()
{
    srand((int)(shootingStarTimer*137+totalDays));
    shootingStar.x=((rand()%400)-200)*1.0f;
    shootingStar.y=100.0f+(rand()%80);
    shootingStar.z=((rand()%400)-200)*1.0f;
    float sp=2.8f+(rand()%4);
    shootingStar.dx=((rand()%12)-6)*0.18f;
    shootingStar.dy=-sp;
    shootingStar.dz=((rand()%12)-6)*0.18f;
    shootingStar.maxLife=45.0f+(rand()%25);
    shootingStar.life=shootingStar.maxLife;
    shootingStar.active=true;
}

void drawShootingStar()
{
    if (!shootingStar.active) return;
    glDisable(GL_LIGHTING);
    float alpha=shootingStar.life/shootingStar.maxLife;
    glLineWidth(2.5f);
    glBegin(GL_LINES);
    glColor4f(1.0f,1.0f,0.9f,alpha);
    glVertex3f(shootingStar.x,shootingStar.y,shootingStar.z);
    glColor4f(1.0f,0.75f,0.25f,0.0f);
    glVertex3f(shootingStar.x-shootingStar.dx*8,
               shootingStar.y-shootingStar.dy*8,
               shootingStar.z-shootingStar.dz*8);
    glEnd();
    glLineWidth(1.0f);
    glEnable(GL_LIGHTING);
