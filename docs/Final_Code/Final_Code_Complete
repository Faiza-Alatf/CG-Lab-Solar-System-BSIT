void drawBandedSphere(float radius, int numBands,
    float r1, float g1, float b1,
    float r2, float g2, float b2,
    float r3=-1, float g3=0, float b3=0)
{
    int slices = 64, stacks = numBands * 2;
    for (int i = 0; i < stacks; i++) {
        float t0 = (float)i / stacks;
        float t1 = (float)(i+1) / stacks;
        float phi0 = PI * (t0 - 0.5f);
        float phi1 = PI * (t1 - 0.5f);

        float bandVal = sinf((float)i / stacks * PI * numBands * 2.0f);
        float mix = (bandVal + 1.0f) * 0.5f;
        float cr, cg, cb;
        if (r3 >= 0 && i % 7 == 3) {
            cr = r3; cg = g3; cb = b3;
        } else {
            cr = r1 + (r2-r1)*mix;
            cg = g1 + (g2-g1)*mix;
            cb = b1 + (b2-b1)*mix;
        }
        glColor3f(cr, cg, cb);

        glBegin(GL_QUAD_STRIP);
        for (int j = 0; j <= slices; j++) {
            float theta = 2.0f * PI * j / slices;
            float ct = cosf(theta), st = sinf(theta);
            float cp0 = cosf(phi0), sp0 = sinf(phi0);
            float cp1 = cosf(phi1), sp1 = sinf(phi1);
            glNormal3f(ct*cp0, sp0, st*cp0);
            glVertex3f(radius*ct*cp0, radius*sp0, radius*st*cp0);
            glNormal3f(ct*cp1, sp1, st*cp1);
            glVertex3f(radius*ct*cp1, radius*sp1, radius*st*cp1);
        }
        glEnd();
    }
}

void drawEarthSphere(float radius)
{
    int slices = 64, stacks = 64;
    for (int i = 0; i < stacks; i++) {
        float phi0 = PI * ((float)i/stacks - 0.5f);
        float phi1 = PI * ((float)(i+1)/stacks - 0.5f);

        glBegin(GL_QUAD_STRIP);
        for (int j = 0; j <= slices; j++) {
            float theta = 2.0f * PI * j / slices;
            float ct = cosf(theta), st = sinf(theta);
            float cp0 = cosf(phi0), sp0 = sinf(phi0);
            float cp1 = cosf(phi1), sp1 = sinf(phi1);

            float nx = ct * cp0, ny = sp0, nz = st * cp0;
            float landNoise = sinf(nx * 3.7f + 1.2f) * cosf(ny * 4.1f) * sinf(nz * 3.3f + 0.8f)
                            + 0.5f * sinf(nx * 7.3f) * cosf(nz * 6.1f);
            bool isLand = (landNoise > 0.15f);
            bool isPole = (fabsf(phi0) > 1.2f);

            if (isPole) glColor3f(0.92f, 0.95f, 1.0f);
            else if (isLand) glColor3f(0.18f + 0.1f*landNoise, 0.55f + 0.08f*landNoise, 0.22f);
            else             glColor3f(0.08f, 0.28f + 0.1f*(phi0+1.5f)/3.0f, 0.72f);

            glNormal3f(ct*cp0, sp0, st*cp0);
            glVertex3f(radius*ct*cp0, radius*sp0, radius*st*cp0);

            nx = ct*cp1; ny = sp1; nz = st*cp1;
            landNoise = sinf(nx*3.7f+1.2f)*cosf(ny*4.1f)*sinf(nz*3.3f+0.8f)
                      + 0.5f*sinf(nx*7.3f)*cosf(nz*6.1f);
            isLand = (landNoise > 0.15f);
            isPole = (fabsf(phi1) > 1.2f);

            if (isPole) glColor3f(0.92f, 0.95f, 1.0f);
            else if (isLand) glColor3f(0.18f+0.1f*landNoise, 0.55f+0.08f*landNoise, 0.22f);
            else             glColor3f(0.08f, 0.28f+0.1f*(phi1+1.5f)/3.0f, 0.72f);

            glNormal3f(ct*cp1, sp1, st*cp1);
            glVertex3f(radius*ct*cp1, radius*sp1, radius*st*cp1);
        }
        glEnd();
    }
}

void drawMarsSphere(float radius)
{
    int slices = 64, stacks = 64;
    for (int i = 0; i < stacks; i++) {
        float phi0 = PI * ((float)i/stacks - 0.5f);
        float phi1 = PI * ((float)(i+1)/stacks - 0.5f);
        glBegin(GL_QUAD_STRIP);
        for (int j = 0; j <= slices; j++) {
            float theta = 2.0f * PI * j / slices;
            float ct = cosf(theta), st = sinf(theta);
            float cp0 = cosf(phi0), sp0 = sinf(phi0);
            float cp1 = cosf(phi1), sp1 = sinf(phi1);

            float nx = ct*cp0, ny=sp0, nz=st*cp0;
            float n = sinf(nx*5.1f)*cosf(ny*4.3f)*sinf(nz*6.7f);
            bool crater = (sinf(nx*11.3f+0.5f)*cosf(nz*9.7f) > 0.65f);
            bool pole = (fabsf(phi0) > 1.35f);

            if (pole)        glColor3f(0.92f, 0.88f, 0.85f);
            else if (crater) glColor3f(0.48f+n*0.05f, 0.18f+n*0.04f, 0.10f+n*0.03f);
            else             glColor3f(0.78f+n*0.08f, 0.32f+n*0.06f, 0.12f+n*0.04f);

            glNormal3f(ct*cp0, sp0, st*cp0);
            glVertex3f(radius*ct*cp0, radius*sp0, radius*st*cp0);

            nx=ct*cp1; ny=sp1; nz=st*cp1;
            n = sinf(nx*5.1f)*cosf(ny*4.3f)*sinf(nz*6.7f);
            crater=(sinf(nx*11.3f+0.5f)*cosf(nz*9.7f)>0.65f);
            pole=(fabsf(phi1)>1.35f);

            if (pole)        glColor3f(0.92f,0.88f,0.85f);
            else if (crater) glColor3f(0.48f+n*0.05f,0.18f+n*0.04f,0.10f+n*0.03f);
            else             glColor3f(0.78f+n*0.08f,0.32f+n*0.06f,0.12f+n*0.04f);

            glNormal3f(ct*cp1, sp1, st*cp1);
            glVertex3f(radius*ct*cp1, radius*sp1, radius*st*cp1);
        }
        glEnd();
    }
}

void drawMercurySphere(float radius)
{
    int slices = 48, stacks = 48;
    for (int i = 0; i < stacks; i++) {
        float phi0 = PI*((float)i/stacks-0.5f);
        float phi1 = PI*((float)(i+1)/stacks-0.5f);
        glBegin(GL_QUAD_STRIP);
        for (int j = 0; j <= slices; j++) {
            float theta = 2.0f*PI*j/slices;
            float ct=cosf(theta), st=sinf(theta);
            float cp0=cosf(phi0), sp0=sinf(phi0);
            float cp1=cosf(phi1), sp1=sinf(phi1);

            float nx=ct*cp0, ny=sp0, nz=st*cp0;
            float n = sinf(nx*8.1f+0.3f)*cosf(ny*7.3f)*sinf(nz*9.7f);
            float base = 0.52f + n*0.12f;
            glColor3f(base, base*0.97f, base*0.93f);
            glNormal3f(ct*cp0,sp0,st*cp0);
            glVertex3f(radius*ct*cp0,radius*sp0,radius*st*cp0);

            nx=ct*cp1; ny=sp1; nz=st*cp1;
            n=sinf(nx*8.1f+0.3f)*cosf(ny*7.3f)*sinf(nz*9.7f);
            base=0.52f+n*0.12f;
            glColor3f(base,base*0.97f,base*0.93f);
            glNormal3f(ct*cp1,sp1,st*cp1);
            glVertex3f(radius*ct*cp1,radius*sp1,radius*st*cp1);
        }
        glEnd();
    }
}

void drawVenusSphere(float radius)
{
    int slices=64, stacks=64;
    for (int i=0; i<stacks; i++) {
        float phi0=PI*((float)i/stacks-0.5f);
        float phi1=PI*((float)(i+1)/stacks-0.5f);
        glBegin(GL_QUAD_STRIP);
        for (int j=0; j<=slices; j++) {
            float theta=2.0f*PI*j/slices;
            float ct=cosf(theta), st=sinf(theta);
            float cp0=cosf(phi0), sp0=sinf(phi0);
            float cp1=cosf(phi1), sp1=sinf(phi1);

            float nx=ct*cp0, ny=sp0, nz=st*cp0;
            float swirl=sinf(nx*4.0f+ny*3.0f)*cosf(nz*5.0f+nx*2.0f);
            float band =cosf(phi0*6.0f)*0.3f;
            float v=0.75f+swirl*0.12f+band;
            glColor3f(fminf(v*1.0f,1.0f), fminf(v*0.82f,1.0f), fminf(v*0.35f,1.0f));
            glNormal3f(ct*cp0,sp0,st*cp0);
            glVertex3f(radius*ct*cp0,radius*sp0,radius*st*cp0);

            nx=ct*cp1; ny=sp1; nz=st*cp1;
            swirl=sinf(nx*4.0f+ny*3.0f)*cosf(nz*5.0f+nx*2.0f);
            band=cosf(phi1*6.0f)*0.3f;
            v=0.75f+swirl*0.12f+band;
            glColor3f(fminf(v,1.0f),fminf(v*0.82f,1.0f),fminf(v*0.35f,1.0f));
            glNormal3f(ct*cp1,sp1,st*cp1);
            glVertex3f(radius*ct*cp1,radius*sp1,radius*st*cp1);
        }
        glEnd();
    }
}

void drawIceGiantSphere(float radius, float hr, float hg, float hb,
                                      float lr, float lg, float lb)
{
    int slices=64, stacks=64;
    for (int i=0; i<stacks; i++) {
        float phi0=PI*((float)i/stacks-0.5f);
        float phi1=PI*((float)(i+1)/stacks-0.5f);
        glBegin(GL_QUAD_STRIP);
        for (int j=0; j<=slices; j++) {
            float theta=2.0f*PI*j/slices;
            float ct=cosf(theta), st=sinf(theta);
            float cp0=cosf(phi0), sp0=sinf(phi0);
            float cp1=cosf(phi1), sp1=sinf(phi1);

            float nx=ct*cp0, nz=st*cp0;
            float n=sinf(nx*3.5f)*cosf(nz*4.2f+phi0*2.0f)*0.15f;
            float band=cosf(phi0*4.0f)*0.15f;
            float mix=0.5f+band+n;
            mix=fmaxf(0.0f,fminf(1.0f,mix));
            glColor3f(lr+(hr-lr)*mix, lg+(hg-lg)*mix, lb+(hb-lb)*mix);
            glNormal3f(ct*cp0,sp0,st*cp0);
            glVertex3f(radius*ct*cp0,radius*sp0,radius*st*cp0);

            nx=ct*cp1; nz=st*cp1;
            n=sinf(nx*3.5f)*cosf(nz*4.2f+phi1*2.0f)*0.15f;
            band=cosf(phi1*4.0f)*0.15f;
            mix=fmaxf(0.0f,fminf(1.0f,0.5f+band+n));
            glColor3f(lr+(hr-lr)*mix, lg+(hg-lg)*mix, lb+(hb-lb)*mix);
            glNormal3f(ct*cp1,sp1,st*cp1);
            glVertex3f(radius*ct*cp1,radius*sp1,radius*st*cp1);
        }
        glEnd();
    }
}

