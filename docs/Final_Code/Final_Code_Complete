    glRotatef(sunRotation*0.75f,0,1,0);
    glDepthMask(GL_FALSE);
    glColor4f(0.6f,0.25f,0.0f,0.72f);
    glPushMatrix(); glTranslatef(2.6f,1.4f,2.0f); glScalef(1.0f,0.5f,1.0f); glutSolidSphere(0.36f,12,12); glPopMatrix();
