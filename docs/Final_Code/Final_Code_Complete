void drawSun()
{
    glDisable(GL_LIGHTING);
    float pulse=sinf(sunPulse*0.04f);
    float glowSize=4.5f+0.2f*pulse;

    glDepthMask(GL_FALSE);
    glColor4f(1.0f,0.35f,0.01f,0.025f); glutSolidSphere(glowSize+2.8f,16,16);
    glColor4f(1.0f,0.48f,0.03f,0.045f); glutSolidSphere(glowSize+1.8f,18,18);
    glColor4f(1.0f,0.60f,0.07f,0.08f);  glutSolidSphere(glowSize+0.9f,22,22);
    glColor4f(1.0f,0.70f,0.12f,0.13f);  glutSolidSphere(glowSize+0.3f,26,26);
    glDepthMask(GL_TRUE);

    glPushMatrix();
    glRotatef(sunRotation*0.25f,0,1,0);
    for (int i=0; i<24; i++) {
        float a=i*2.0f*PI/24.0f+sunPulse*0.01f;
        float ri=3.9f, ro=6.2f+0.7f*sinf(sunPulse*0.07f+i*1.3f);
        float alpha=0.12f+0.06f*sinf(sunPulse*0.09f+i);
        glColor4f(1.0f,0.72f,0.18f,alpha);
        glBegin(GL_TRIANGLES);
        float w=0.12f;
        glVertex3f(ri*cosf(a-w),ri*sinf(a-w),0);
        glVertex3f(ri*cosf(a+w),ri*sinf(a+w),0);
        glVertex3f(ro*cosf(a),  ro*sinf(a),  0);
        glEnd();
    }
    glPopMatrix();

    glPushMatrix();
    glRotatef(sunRotation*0.1f,0,1,0);
    for (int i=0; i<6; i++) {
        float a=i*PI/3.0f+sunPulse*0.005f;
